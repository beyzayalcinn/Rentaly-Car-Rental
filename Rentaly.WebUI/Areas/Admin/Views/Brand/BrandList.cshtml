@model List<Rentaly.EntityLayer.Entities.Brand>

@{
    ViewData["Title"] = "Marka Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var brands = Model ?? new List<Rentaly.EntityLayer.Entities.Brand>();
}

<style>
    .brand-page {
        padding: 12px 4px 32px;
        color: #202938;
    }

    .brand-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .brand-heading h2 {
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -0.8px;
        margin: 0 0 7px;
        color: #172033;
    }

    .brand-heading p {
        color: #8791a2;
        font-size: 14px;
        margin: 0;
    }

    .brand-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 18px;
        border-radius: 11px;
        background: #172033;
        color: #fff !important;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        transition: .2s ease;
    }

        .brand-add-btn:hover {
            background: #34415b;
            transform: translateY(-2px);
        }

    .brand-summary {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 24px;
        margin-bottom: 26px;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        background: #fff;
    }

    .brand-summary-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #f0f3f8;
        border-radius: 14px;
        color: #273750;
        font-size: 22px;
    }

    .brand-summary-label {
        color: #8993a3;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .brand-summary-number {
        color: #172033;
        font-size: 25px;
        font-weight: 750;
        line-height: 1.1;
    }

    .brand-summary-note {
        margin-left: auto;
        color: #8b95a5;
        font-size: 12px;
    }

    .brand-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 17px;
        flex-wrap: wrap;
    }

        .brand-toolbar h5 {
            font-size: 16px;
            font-weight: 750;
            color: #263247;
            margin: 0;
        }

    .brand-search {
        position: relative;
        width: 280px;
        max-width: 100%;
    }

        .brand-search i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aa3b2;
            font-size: 13px;
        }

        .brand-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid #e5e9f0;
            border-radius: 10px;
            outline: none;
            background: #fff;
            font-size: 13px;
            transition: .2s;
        }

            .brand-search input:focus {
                border-color: #8997ad;
                box-shadow: 0 0 0 3px rgba(80, 100, 130, .08);
            }

    .brand-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .brand-card {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 16px;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .brand-card:hover {
            transform: translateY(-4px);
            border-color: #d9e0ea;
            box-shadow: 0 12px 30px rgba(25, 40, 65, .07);
        }

    .brand-logo-area {
        height: 158px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 22px;
        background: #f8f9fb;
        border-bottom: 1px solid #edf0f4;
    }

    .brand-logo {
        display: block;
        max-width: 100%;
        max-height: 105px;
        width: auto;
        height: auto;
        object-fit: contain;
        transition: transform .2s ease;
    }

    .brand-card:hover .brand-logo {
        transform: scale(1.05);
    }

    .brand-logo-fallback {
        width: 76px;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e9f0;
        border-radius: 22px;
        background: #fff;
        color: #34435b;
        font-size: 32px;
    }

    .brand-card-body {
        padding: 18px;
    }

    .brand-name {
        overflow: hidden;
        margin: 0 0 6px;
        color: #202b3d;
        font-size: 16px;
        font-weight: 750;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .brand-caption {
        margin: 0;
        color: #9aa3b2;
        font-size: 12px;
    }

    .brand-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 13px 18px;
        border-top: 1px solid #f0f2f6;
    }

    .brand-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #647184;
        font-size: 11px;
    }

    .brand-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #26a269;
    }

    .brand-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .brand-action {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e8ecf2;
        border-radius: 9px;
        background: #fff;
        color: #657186;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

        .brand-action:hover {
            background: #f0f3f8;
            color: #172033;
        }

    .brand-action-delete:hover {
        background: #fff1f0;
        border-color: #ffd9d6;
        color: #d93025;
    }

    .brand-empty {
        grid-column: 1 / -1;
        padding: 55px 20px;
        border: 1px dashed #dce2eb;
        border-radius: 16px;
        background: #fff;
        text-align: center;
    }

        .brand-empty i {
            margin-bottom: 15px;
            color: #aab3c1;
            font-size: 34px;
        }

        .brand-empty h5 {
            color: #273247;
            font-weight: 700;
        }

        .brand-empty p {
            margin: 0;
            color: #929cad;
            font-size: 13px;
        }

    @@media (max-width: 1200px) {
        .brand-grid

    {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    }

    @@media (max-width: 800px) {
        .brand-grid

    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .brand-logo-area {
        height: 135px;
    }

    .brand-card-body,
    .brand-card-footer {
        padding: 13px;
    }

    }

    @@media (max-width: 480px) {
        .brand-grid

    {
        grid-template-columns: 1fr;
    }

    .brand-topbar {
        align-items: flex-start;
    }

    .brand-add-btn {
        width: 100%;
        justify-content: center;
    }

    .brand-summary-note {
        display: none;
    }

    }
</style>

<div class="brand-page">

    <div class="brand-topbar">
        <div class="brand-heading">
            <h2>Marka Yönetimi</h2>
            <p>Araç filonuzdaki otomobil markalarını yönetin.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Brand"
           asp-action="CreateBrand"
           class="brand-add-btn">
            <i class="fa-solid fa-plus"></i>
            Yeni Marka Ekle
        </a>
    </div>

    <div class="brand-summary">
        <div class="brand-summary-icon">
            <i class="fa-solid fa-car-side"></i>
        </div>

        <div>
            <div class="brand-summary-label">Sistemde kayıtlı markalar</div>
            <div class="brand-summary-number">@brands.Count</div>
        </div>

        <div class="brand-summary-note">
            <i class="fa-solid fa-layer-group"></i>
            Marka kataloğu
        </div>
    </div>

    <div class="brand-toolbar">
        <h5>Marka Kataloğu</h5>

        <div class="brand-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text"
                   id="brandSearch"
                   placeholder="Marka ara..."
                   autocomplete="off" />
        </div>
    </div>

    <div class="brand-grid" id="brandGrid">

        @if (brands.Any())
        {
            @foreach (var item in brands)
            {
                <div class="brand-card"
                     data-brand-name="@item.BrandName?.ToLowerInvariant()">

                    <div class="brand-logo-area">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@item.BrandName logo"
                                 class="brand-logo"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="brand-logo-fallback" style="display:none;">
                                <i class="fa-solid fa-car-side"></i>
                            </div>
                        }
                        else
                        {
                            <div class="brand-logo-fallback">
                                <i class="fa-solid fa-car-side"></i>
                            </div>
                        }
                    </div>

                    <div class="brand-card-body">
                        <h5 class="brand-name" title="@item.BrandName">
                            @item.BrandName
                        </h5>
                        <p class="brand-caption">Araç markası</p>
                    </div>

                    <div class="brand-card-footer">
                        <span class="brand-status">
                            <span class="brand-status-dot"></span>
                            Kayıtlı
                        </span>

                        <div class="brand-actions">
                            <a asp-area="Admin"
                               asp-controller="Brand"
                               asp-action="UpdateBrand"
                               asp-route-id="@item.BrandId"
                               class="brand-action"
                               title="Markayı düzenle"
                               aria-label="Markayı düzenle">
                                <i class="fa-solid fa-pen"></i>
                            </a>

                            <a asp-area="Admin"
                               asp-controller="Brand"
                               asp-action="DeleteBrand"
                               asp-route-id="@item.BrandId"
                               class="brand-action brand-action-delete"
                               title="Markayı sil"
                               aria-label="Markayı sil"
                               onclick="return confirm('Bu markayı silmek istediğinize emin misiniz?');">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="brand-empty">
                <i class="fa-solid fa-car-side"></i>
                <h5>Henüz marka eklenmemiş</h5>
                <p>Marka kataloğunu oluşturmak için yeni bir marka ekleyebilirsiniz.</p>
            </div>
        }
    </div>

    <div id="brandNoResults" class="brand-empty" style="display:none; margin-top:16px;">
        <i class="fa-solid fa-magnifying-glass"></i>
        <h5>Marka bulunamadı</h5>
        <p>Farklı bir marka adı deneyin.</p>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("brandSearch");
        const cards = document.querySelectorAll(".brand-card");
        const noResults = document.getElementById("brandNoResults");

        if (!searchInput) return;

        searchInput.addEventListener("input", function () {
            const query = this.value
                .toLocaleLowerCase("tr-TR")
                .trim();

            let visibleCount = 0;

            cards.forEach(function (card) {
                const name = (card.dataset.brandName || "")
                    .toLocaleLowerCase("tr-TR");

                const visible = name.includes(query);
                card.style.display = visible ? "" : "none";

                if (visible) visibleCount++;
            });

            if (noResults) {
                noResults.style.display =
                    cards.length > 0 && visibleCount === 0 ? "block" : "none";
            }
        });
    });
</script>
