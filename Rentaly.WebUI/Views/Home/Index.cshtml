                            {

                                <div class="col-lg-7">

                                    <h2>
                                        Geleceğimiz
                                    </h2>


                                    <div class="row g-3">

                                        @foreach (var item in Model.OurFutures.Take(4))
                                        {

                                            <div class="col-md-6">

                                                <div class="box-icon s2 p-small">

                                                    <i class="fa bg-color @item.Icon"></i>


                                                    <div class="d-inner">

                                                        <h4>
                                                            @item.Title
                                                        </h4>

                                                        <p>
                                                            @item.Description
                                                        </p>

                                                    </div>

                                                </div>

                                            </div>

                                        }

                                    </div>

                                </div>

                            }


                            <!-- AWARDS -->
                            @if (Model.Awards.Any())
                            {

                                <div class="col-lg-5">

                                    <h2>
                                        Ödüllerimiz
                                    </h2>


                                    @foreach (var item in Model.Awards.Take(3))
                                    {

                                        <div class="mb-3">

                                            <h4>
                                                @item.Title
                                            </h4>

                                            <p>
                                                @item.Description
                                            </p>

                                        </div>

                                    }

                                </div>

                            }

                        </div>

                    </div>

                </section>

            }


            <!-- =========================================================
                 CALL TO ACTION
                 ========================================================= -->

            <section id="section-call-to-action"
                     class="bg-color-2 pt60 pb60 text-light">

                <div class="container">

                    <div class="row">


                        <div class="col-lg-4 offset-lg-2">

                            <span class="subtitle text-white">

                                Daha fazla bilgi için bize ulaşın

                            </span>


                            <h2 class="s2">

                                Rentaly müşteri hizmetleri
                                size yardımcı olmak için burada.

                            </h2>

                        </div>


                        <div class="col-lg-4 text-lg-center text-sm-center">


                            <div class="phone-num-big">

                                <i class="fa fa-phone"></i>


                                <span class="pnb-text">
                                    Hemen Arayın
                                </span>


                                <span class="pnb-num">
                                    +90 555 555 55 55
                                </span>

                            </div>


                            <a href="/Home/Contact"
                               class="btn-main">

                                Bize Ulaşın

                            </a>

                        </div>

                    </div>

                </div>

            </section>

        </div>


        <!-- =========================================================
             FOOTER
             ========================================================= -->

        <footer class="text-light">

            <div class="container">

                <div class="row g-custom-x">


                    <!-- ABOUT -->

                    <div class="col-lg-3">

                        <div class="widget">

                            <h5>
                                Rentaly Hakkında
