                                        Giriş Yap
                                    </a>

                                    <span id="menu-btn"></span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </header>


        <!-- =========================================================
             CONTENT
             ========================================================= -->

        <div class="no-bottom no-top"
             id="content">

            <div id="top"></div>


            <!-- =====================================================
                 HERO
                 ===================================================== -->

            <section id="section-hero"
                     aria-label="Araç kiralama"
                     class="jarallax">

                <img src="/RentalyTema/images/background/1.jpg"
                     class="jarallax-img"
                     alt="Rentaly">


                <div class="container">

                    <div class="row align-items-center">

                        <div class="col-lg-12 text-light">

                            <div class="spacer-double"></div>

                            <div class="spacer-double"></div>


                            <h1 class="mb-2">

                                Aradığınız

                                <span class="id-color">
                                    aracı
                                </span>

                                burada bulabilirsiniz.

                            </h1>


                            <p class="lead text-light">

                                İhtiyacınıza uygun aracı seçin,
                                tarihlerinizi belirleyin ve
                                birkaç adımda rezervasyonunuzu oluşturun.

                            </p>


                            <div class="spacer-single"></div>

                        </div>


                    

                        <!-- =================================================
                             NASIL ÇALIŞIR
                             ================================================= -->

                        <div class="spacer-double"></div>


                        <div class="row">

                            <div class="col-lg-12 text-light">

                                <div class="container-timeline">

                                    <ul>

                                        <li>

                                            <h4>
                                                Aracınızı seçin
                                            </h4>

                                            <p>
                                                İhtiyacınıza uygun araçları
