@model Rentaly.EntityLayer.Entities.Branch

@{
    ViewData["Title"] = "Şube Güncelle";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Şube Güncelle</h2>
        <p class="text-muted">
            Şube bilgilerini güncelleyin.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                Şube Bilgileri
            </h5>
        </div>

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Branch"
                  asp-action="Update"
                  method="post">

                <input type="hidden"
                       asp-for="BranchId" />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Şube Adı
                        </label>

                        <input asp-for="BranchName"
                               class="form-control"
                               required />

                        <span asp-validation-for="BranchName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Şehir
                        </label>

                        <input asp-for="City"
                               class="form-control"
                               required />

                        <span asp-validation-for="City"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Adres
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="4"
                                  required></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Branch/Index"
                       class="btn btn-secondary">
                        Vazgeç
                    </a>

                    <button type="submit"
                            class="btn btn-success">
                        <i class="fas fa-save"></i>
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>