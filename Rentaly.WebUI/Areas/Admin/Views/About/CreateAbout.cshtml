@model Rentaly.EntityLayer.Entities.About

@{
    ViewData["Title"] = "Yeni Hakkımızda";
}
<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Yeni Hakkımızda</h3>
            <p class="text-muted mb-0">
                Ana sayfada gösterilecek hakkımızda bilgilerini ekleyin.
            </p>
        </div>

        <a href="/Admin/About/AboutList" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post" action="/Admin/About/CreateAbout">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Başlık</label>
                        <input type="text"
                               asp-for="Title"
                               class="form-control"
                               placeholder="Örn: Rentaly Hakkında" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Görsel URL</label>
                        <input type="text"
                               asp-for="ImageUrl"
                               class="form-control"
                               placeholder="Görsel adresini giriniz" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Hakkımızda açıklamasını giriniz"></textarea>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Video URL</label>
                        <input type="text"
                               asp-for="VideoUrl"
                               class="form-control"
                               placeholder="Video adresini giriniz" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mutlu Müşteri Sayısı</label>
                        <input type="number"
                               asp-for="HappyCustomerCount"
                               class="form-control"
                               min="0" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Araç Sayısı</label>
                        <input type="number"
                               asp-for="CarCount"
                               class="form-control"
                               min="0" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Şube Sayısı</label>
                        <input type="number"
                               asp-for="BranchCount"
                               class="form-control"
                               min="0" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Deneyim Yılı</label>
                        <input type="number"
                               asp-for="ExperienceYear"
                               class="form-control"
                               min="0" />
                    </div>

                    <div class="col-md-12 mb-4">
                        <div class="form-check">
                            <input type="checkbox"
                                   asp-for="Status"
                                   class="form-check-input" />

                            <label class="form-check-label">
                                Aktif olarak göster
                            </label>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/About/AboutList"
                       class="btn btn-light">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        Kaydet
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>