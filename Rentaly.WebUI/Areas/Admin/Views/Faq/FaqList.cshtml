
@model List<Rentaly.EntityLayer.Entities.Faq>

@{
    ViewData["Title"] = "SSS";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">Sıkça Sorulan Sorular</h3>

            <p class="text-muted mb-0">
                Ana sayfada gösterilecek sıkça sorulan soruları yönetin.
            </p>
        </div>

        <a href="/Admin/Faq/CreateFaq"
           class="btn btn-primary">

            <i class="fa fa-plus"></i>
            Yeni Soru

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>#</th>
                            <th>Soru</th>
                            <th>Cevap</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th>İşlemler</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model.OrderBy(x => x.Order))
                            {
                                <tr>

                                    <td>
                                        @item.FaqId
                                    </td>


                                    <td style="min-width:250px;">

                                        <strong>
                                            @item.Question
                                        </strong>

                                    </td>


                                    <td style="max-width:400px;">

                                        @item.Answer

                                    </td>


                                    <td>

                                        @item.Order

                                    </td>


                                    <td>

                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Pasif
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <a href="/Admin/Faq/UpdateFaq/@item.FaqId"
                                           class="btn btn-sm btn-warning">

                                            <i class="fa fa-edit"></i>
                                            Güncelle

                                        </a>


                                        <a href="/Admin/Faq/DeleteFaq/@item.FaqId"
                                           class="btn btn-sm btn-danger"
                                           onclick="return confirm('Bu soruyu silmek istediğinize emin misiniz?');">

                                            <i class="fa fa-trash"></i>
                                            Sil

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="fa fa-circle-question fa-2x mb-3"></i>

                                        <div class="fw-bold mb-1">
                                            Henüz SSS bulunmuyor.
                                        </div>

                                        <div>
                                            İlk sıkça sorulan soruyu ekleyebilirsiniz.
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
