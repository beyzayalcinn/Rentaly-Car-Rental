@model List<Rentaly.EntityLayer.Entities.OurFuture>

@{
    ViewData["Title"] = "Our Future";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Our Future</h3>
            <p class="text-muted mb-0">
                Ana sayfadaki Our Future içeriklerini yönetin.
            </p>
        </div>

        <a href="/Admin/OurFuture/CreateOurFuture" class="btn btn-primary">
            <i class="fa fa-plus"></i> Yeni İçerik
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>İkon</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.OrderBy(x => x.Order))
                        {
                            <tr>

                                <td>
                                    @item.OurFutureId
                                </td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.Icon))
                                    {
                                        <i class="@item.Icon"></i>
                                    }
                                </td>

                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td style="max-width: 350px;">
                                    @item.Description
                                </td>

                                <td>
                                    @item.Order
                                </td>

                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success">
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Pasif
                                        </span>
                                    }
                                </td>

                                <td>

                                    <a href="/Admin/OurFuture/UpdateOurFuture/@item.OurFutureId"
                                       class="btn btn-sm btn-warning">
                                        Güncelle
                                    </a>

                                    <a href="/Admin/OurFuture/DeleteOurFuture/@item.OurFutureId"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Bu içeriği silmek istediğinize emin misiniz?');">
                                        Sil
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>