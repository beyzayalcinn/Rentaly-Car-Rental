                                    </a>

                                </span>

                            </address>

                        </div>

                    </div>


                    <!-- QUICK LINKS -->

                    <div class="col-lg-3">

                        <div class="widget">

                            <h5>
                                Hızlı Bağlantılar
                            </h5>


                            <ul>

                                <li>
                                    <a href="/Home/About">
                                        Hakkımızda
                                    </a>
                                </li>


                                <li>
                                    <a href="/Car/CarList">
