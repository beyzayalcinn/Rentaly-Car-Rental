                                                 data-tab="#@id">
                                                @item.Question
                                            </div>

                                            <div class="accordion-section-content" id="@id">
                                                <p>@item.Answer</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="testimonial-empty">
                            <div class="testimonial-empty-icon">?</div>
                            <h4>Henüz soru eklenmedi</h4>
                            <p>Sorular eklendiğinde burada görüntülenecektir.</p>
                        </div>
                    }

                    <div class="text-center mt-4">
                        <p>Aradığınız cevabı bulamadınız mı?</p>
                        <a href="/Home/Contact" class="btn-main">Bize Ulaşın</a>
                    </div>

                </div>
            </section>



            <!-- =========================================================
                 GELECEĞİMİZ / ÖDÜLLER
                 ========================================================= -->
            @if (Model.OurFutures.Any() || Model.Awards.Any())
            {

                <section aria-label="Rentaly geleceği ve ödülleri">

                    <div class="container">

                        <div class="row g-4">


                            <!-- OUR FUTURE -->
