@model Rentaly.EntityLayer.Entities.Brand

@{
    ViewData["Title"] = "Yeni Marka";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Yeni Marka</h3>
            <p class="text-muted mb-0">
                Sisteme yeni bir araç markası ekleyin.
            </p>
        </div>

        <a href="/Admin/Brand/BrandList" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post" action="/Admin/Brand/CreateBrand">

                <div class="mb-3">
                    <label class="form-label">Marka Adı</label>

                    <input type="text"
                           asp-for="BrandName"
                           class="form-control"
                           placeholder="Örn: BMW, Mercedes, Audi..." />
                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Brand/BrandList"
                       class="btn btn-light">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        Kaydet
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>