@model Rentaly.EntityLayer.Entities.Testimonial

@{
    ViewData["Title"] = "Müşteri Yorumu Güncelle";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Müşteri Yorumu Güncelle</h3>
            <p class="text-muted mb-0">
                Mevcut müşteri yorumunu düzenleyin.
            </p>
        </div>

        <a href="/Admin/Testimonial/TestimonialList" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post" action="/Admin/Testimonial/UpdateTestimonial">

                <input type="hidden" asp-for="TestimonialId" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ad Soyad</label>

                        <input type="text"
                               asp-for="Name"
                               class="form-control"
                               placeholder="Ad Soyad" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Meslek</label>

                        <input type="text"
                               asp-for="Job"
                               class="form-control"
                               placeholder="Meslek" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Yorum</label>

                        <textarea asp-for="Comment"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Müşteri yorumunu giriniz"></textarea>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Görsel URL</label>

                        <input type="text"
                               asp-for="ImageUrl"
                               class="form-control"
                               placeholder="Görsel adresi" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Puan</label>

                        <input type="number"
                               asp-for="Rating"
                               class="form-control"
                               min="1"
                               max="5" />

                        <small class="text-muted">
                            1 ile 5 arasında bir puan giriniz.
                        </small>
                    </div>

                    <div class="col-md-12 mb-4">

                        <div class="form-check">

                            <input type="checkbox"
                                   asp-for="Status"
                                   class="form-check-input" />

                            <label class="form-check-label">
                                Aktif olarak göster
                            </label>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Testimonial/TestimonialList"
                       class="btn btn-light">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn btn-warning">
                        <i class="fa fa-edit"></i>
                        Güncelle
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>