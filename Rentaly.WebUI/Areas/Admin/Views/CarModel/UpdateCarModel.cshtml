@model Rentaly.EntityLayer.Entities.CarModel

@{
    ViewData["Title"] = "Araç Modeli Güncelle";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Araç Modeli Güncelle</h3>
            <p class="text-muted mb-0">
                Mevcut araç modelini düzenleyin.
            </p>
        </div>

        <a href="/Admin/CarModel/CarModelList" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post" action="/Admin/CarModel/UpdateCarModel">

                <input type="hidden" asp-for="CarModelId" />

                <div class="mb-3">
                    <label class="form-label">Model Adı</label>

                    <input type="text"
                           asp-for="ModelName"
                           class="form-control"
                           placeholder="Model adını giriniz" />
                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/CarModel/CarModelList"
                       class="btn btn-light">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn btn-warning">
                        <i class="fa fa-edit"></i>
                        Güncelle
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>