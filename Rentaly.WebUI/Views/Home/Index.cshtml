                            <div class="social-icons">

                                <a href="#">
                                    <i class="fa fa-facebook fa-lg"></i>
                                </a>


                                <a href="#">
                                    <i class="fa fa-twitter fa-lg"></i>
                                </a>


                                <a href="#">
                                    <i class="fa fa-linkedin fa-lg"></i>
                                </a>


                                <a href="#">
                                    <i class="fa fa-instagram fa-lg"></i>
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- SUBFOOTER -->

            <div class="subfooter">

                <div class="container">

                    <div class="row">

                        <div class="col-md-12">

                            <div class="de-flex">


                                <div class="de-flex-col">

                                    <a href="/">

                                        Copyright 2026 - Rentaly

                                    </a>

                                </div>


                                <ul class="menu-simple">

                                    <li>

                                        <a href="#">
                                            Kullanım Koşulları
