
@model Rentaly.EntityLayer.Entities.WhyChooseUs

@{
    ViewData["Title"] = "İçerik Güncelle";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">İçerik Güncelle</h3>

            <p class="text-muted mb-0">
                Mevcut "Neden Bizi Seçmelisiniz?" içeriğini düzenleyin.
            </p>
        </div>

        <a href="/Admin/WhyChooseUs/WhyChooseUsList"
           class="btn btn-secondary">

            <i class="fa fa-arrow-left"></i>
            Listeye Dön

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form method="post"
                  action="/Admin/WhyChooseUs/UpdateWhyChooseUs">

                <input type="hidden"
                       asp-for="WhyChooseUsId" />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Title"
                               class="form-label">
                            Başlık
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="İçerik başlığı" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Icon"
                               class="form-label">
                            İkon
                        </label>

                        <input asp-for="Icon"
                               class="form-control"
                               placeholder="Örn: fa fa-shield" />

                    </div>

                    <div class="col-md-12 mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="İçerik açıklaması"></textarea>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Order"
                               class="form-label">
                            Sıra
                        </label>

                        <input asp-for="Order"
                               type="number"
                               class="form-control"
                               min="1" />

                    </div>

                    <div class="col-md-6 mb-3 d-flex align-items-end">

                        <div class="form-check mb-2">

                            <input asp-for="Status"
                                   class="form-check-input" />

                            <label asp-for="Status"
                                   class="form-check-label">
                                Aktif olarak göster
                            </label>

                        </div>

                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/WhyChooseUs/WhyChooseUsList"
                       class="btn btn-light">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="fa fa-edit"></i>
                        Güncelle

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
