                </div>

            </div>


            <!-- NAVBAR -->

            <div class="container">

                <div class="row">

                    <div class="col-md-12">

                        <div class="de-flex sm-pt10">

                            <!-- LOGO -->

                            <div class="de-flex-col">

                                <div id="logo">

                                    <a href="/">

                                        <img class="logo-1"
                                             src="/RentalyTema/images/logo-light.png"
                                             alt="Rentaly">

                                        <img class="logo-2"
                                             src="/RentalyTema/images/logo.png"
                                             alt="Rentaly">

                                    </a>

                                </div>

                            </div>


                            <!-- MENU -->

                            <div class="de-flex-col header-col-mid">

                                <ul id="mainmenu">

                                    <li>
                                        <a class="menu-item"
                                           href="/">
                                            Ana Sayfa
                                        </a>
                                    </li>

                                    <li>
                                        <a class="menu-item"
                                           href="/Car/CarList">
                                            Araçlar
                                        </a>
                                    </li>

                                    <li>
                                        <a class="menu-item"
                                           href="/Booking">
                                            Rezervasyon
                                        </a>
                                    </li>

                                    <li>
                                        <a class="menu-item"
                                           href="/Account">
                                            Hesabım
                                        </a>
                                    </li>

                                    <li>
                                        <a class="menu-item"
                                           href="/Home/About">
                                            Hakkımızda
                                        </a>
                                    </li>

                                    <li>
                                        <a class="menu-item"
                                           href="/Home/Contact">
                                            İletişim
                                        </a>
                                    </li>

                                </ul>

                            </div>


                            <!-- SIGN IN -->

                            <div class="de-flex-col">

                                <div class="menu_side_area">

                                    <a href="/Login"
