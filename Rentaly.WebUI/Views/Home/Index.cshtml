                            <p>
                                Kalite ve uygun fiyatı bir araya getiriyoruz.
                                Rentaly, güvenilir araçları ve kolay kiralama
                                süreciyle konforlu yolculuklar sunar.
                            </p>

                        </div>

                    </div>


                    <!-- CONTACT -->

                    <div class="col-lg-3">

                        <div class="widget">

                            <h5>
                                İletişim Bilgileri
                            </h5>


                            <address class="s1">

                                <span>

                                    <i class="id-color fa fa-map-marker fa-lg"></i>

                                    İstanbul, Türkiye

                                </span>


                                <span>

                                    <i class="id-color fa fa-phone fa-lg"></i>

                                    +90 555 555 55 55

                                </span>


                                <span>

                                    <i class="id-color fa fa-envelope-o fa-lg"></i>

                                    <a href="mailto:contact@rentaly.com">

