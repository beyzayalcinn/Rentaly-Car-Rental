@model Rentaly.EntityLayer.Entities.CarModel

@{
    ViewData["Title"] = "Yeni Araç Modeli";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Yeni Araç Modeli</h3>
            <p class="text-muted mb-0">
                Sisteme yeni bir araç modeli ekleyin.
            </p>
        </div>

        <a href="/Admin/CarModel/CarModelList" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Listeye Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form method="post" action="/Admin/CarModel/CreateCarModel">

                <div class="row">

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Model Adı</label>

                        <input type="text"
                               asp-for="ModelName"
                               class="form-control"
                               placeholder="Örn: Corolla, Passat, Clio..." />
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/CarModel/CarModelList"
                       class="btn btn-light">
                        İptal
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        Kaydet
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>