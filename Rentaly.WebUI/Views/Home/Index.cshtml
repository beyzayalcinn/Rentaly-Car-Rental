<!-- =========================================================
     MÜŞTERİ YORUMU GÖNDERME FORMU
     Yorum listesi döngüsünün DIŞINDA olmalı.
     ========================================================= -->

<section id="review-form" class="container my-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="p-4 border rounded">

                <h3 class="text-center mb-4">
                    Deneyiminizi Paylaşın
                </h3>

                <p class="text-center">
                    Rentaly hakkındaki görüşlerinizi bizimle paylaşabilirsiniz.
                </p>

                @if (TempData["ReviewSuccess"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["ReviewSuccess"]
                    </div>
                }

                @if (TempData["ReviewError"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["ReviewError"]
                    </div>
                }

                <form asp-controller="Home"
                      asp-action="SubmitTestimonial"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="Name" class="form-label">
                            Adınız
                        </label>
                        <input type="text"
                               id="Name"
                               name="Name"
                               class="form-control"
                               maxlength="100"
                               required />
                    </div>
                    <div class="mb-3">
                        <label for="Rating" class="form-label">
                            Puanınız
                        </label>
                        <select id="Rating"
                                name="Rating"
                                class="form-select"
                                required>
                            <option value="">Puan seçin</option>
                            <option value="5">★★★★★ - Çok iyi</option>
                            <option value="4">★★★★ - İyi</option>
                            <option value="3">★★★ - Orta</option>
                            <option value="2">★★ - Kötü</option>
                            <option value="1">★ - Çok kötü</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="Comment" class="form-label">
                            Yorumunuz
                        </label>
                        <textarea id="Comment"
                                  name="Comment"
                                  class="form-control"
                                  rows="5"
                                  minlength="10"
                                  maxlength="1000"
                                  required></textarea>
                    </div>

                    <button type="submit" class="btn-main">
                        Yorumu Gönder
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>


