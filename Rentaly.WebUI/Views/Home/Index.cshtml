@model Rentaly.WebUI.Models.HomeViewModel


<!DOCTYPE html>

<html lang="tr">

<head>
    <title>Rentaly - Araç Kiralama</title>

    <link rel="icon"
          href="/RentalyTema/images/icon.png"
          type="image/gif"
          sizes="16x16">

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Rentaly - Güvenli, konforlu ve uygun fiyatlı araç kiralama">

    <meta name="keywords"
          content="araç kiralama, araba kiralama, rent a car, Rentaly">

    <meta name="author"
          content="Rentaly">

    <link href="/RentalyTema/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="/RentalyTema/css/mdb.min.css"
          rel="stylesheet">

    <link href="/RentalyTema/css/plugins.css"
          rel="stylesheet">

    <link href="/RentalyTema/css/style.css"
          rel="stylesheet">

    <link href="/RentalyTema/css/coloring.css"
          rel="stylesheet">

    <link id="colors"
          href="/RentalyTema/css/colors/scheme-01.css"
          rel="stylesheet">

    <style>

        /* =========================================================
                   ARAÇ TİPİ KARTLARI
                   ========================================================= */

        .vehicle-type-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 105px;
            padding: 18px 10px;
            border: 1px solid #e5e5e5;
            border-radius: 14px;
            background: #ffffff;
            cursor: pointer;
            text-align: center;
            transition: all .25s ease;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
        }

            .vehicle-type-card i {
                font-size: 30px;
                margin-bottom: 10px;
                color: #f5a623;
                transition: all .25s ease;
            }

            .vehicle-type-card span {
                font-size: 14px;
                font-weight: 600;
                color: #333;
                line-height: 1.3;
            }

            .vehicle-type-card:hover {
                transform: translateY(-4px);
                border-color: #f5a623;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
            }

        input[type="radio"]:checked + .vehicle-type-card {
            background: #f5a623;
            border-color: #f5a623;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

            input[type="radio"]:checked + .vehicle-type-card i,
            input[type="radio"]:checked + .vehicle-type-card span {
                color: #ffffff;
            }


        /* =========================================================
                   ARAMA FORMU
                   ========================================================= */

        .rental-search-box {
            border-radius: 18px !important;
        }

            .rental-search-box h5 {
                margin-bottom: 12px;
            }

            .rental-search-box select,
            .rental-search-box input {
                border-radius: 8px;
            }


        /* =========================================================
                   ABOUT KARTLARI
                   ========================================================= */

        .rental-about-card {
            padding: 25px 15px;
            height: 100%;
            text-align: center;
            border-radius: 14px;
            background: rgba(255,255,255,.08);
        }

            .rental-about-card i {
                font-size: 34px;
                margin-bottom: 15px;
            }


        /* =========================================================
                   MODEL KARTLARI
                   ========================================================= */

        .rental-model-card {
            padding: 20px;
            border: 1px solid #eeeeee;
            border-radius: 12px;
            background: #ffffff;
            transition: all .25s ease;
        }

            .rental-model-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(0,0,0,.08);
            }


        /* =========================================================
                   MARKA
                   ========================================================= */

        .rental-brand-card {
            padding: 20px;
            border-radius: 12px;
            transition: all .25s ease;
        }

            .rental-brand-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(0,0,0,.07);
            }


        /* =========================================================
                   MOBİL
                   ========================================================= */

        @@media (max-width: 767px) {

            .vehicle-type-card {
                min-height: 95px;
            }

                .vehicle-type-card i {
                    font-size: 25px;
                }

                .vehicle-type-card span {
                    font-size: 13px;
                }
        }

        /* Rentaly müşteri yorumları */
        .rentaly-testimonials {
            padding: 85px 0;
            background: #f7f8fa;
        }

        .testimonial-eyebrow {
            display: inline-block;
            margin-bottom: 12px;
            color: #f5a623;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .testimonial-heading {
            margin-bottom: 12px;
            color: #172033;
            font-size: clamp(26px, 3vw, 38px);
            font-weight: 750;
        }

        .testimonial-subtitle {
            color: #737b8c;
            font-size: 15px;
        }

        .testimonial-card {
            height: 100%;
            padding: 28px;
            background: #fff;
            border: 1px solid #e9edf2;
            border-radius: 16px;
            box-shadow: 0 8px 28px rgba(20, 35, 60, 0.045);
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .testimonial-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(20, 35, 60, 0.09);
            }

        .testimonial-stars {
            margin-bottom: 12px;
            font-size: 19px;
            letter-spacing: 2px;
        }

        .star-filled {
            color: #f5a623;
        }

        .star-empty {
            color: #dce1e8;
        }

        .testimonial-quote-mark {
            height: 32px;
            color: #f5a623;
            font-family: Georgia, serif;
            font-size: 48px;
            line-height: 1;
        }

        .testimonial-comment {
            min-height: 90px;
            margin: 12px 0 22px;
            color: #4d5668;
            font-size: 15px;
            line-height: 1.8;
            overflow-wrap: anywhere;
        }

        .testimonial-divider {
            height: 1px;
            margin-bottom: 20px;
            background: #edf0f4;
        }

        .testimonial-customer {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .testimonial-avatar {
            display: flex;
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #fff2d9;
            color: #a96700;
            font-size: 18px;
            font-weight: 800;
        }

        .testimonial-name {
            margin: 0 0 4px;
            color: #172033;
            font-size: 15px;
            font-weight: 700;
        }

        .testimonial-job {
            color: #8790a0;
            font-size: 12px;
        }

        .testimonial-empty {
            max-width: 560px;
            margin: auto;
            padding: 40px 24px;
            text-align: center;
            background: #fff;
            border: 1px solid #e9edf2;
            border-radius: 16px;
        }

        .testimonial-empty-icon {
            margin-bottom: 10px;
            color: #f5a623;
            font-size: 38px;
        }

        .testimonial-empty h4 {
            color: #172033;
            font-weight: 700;
        }

        .testimonial-empty p {
            margin-bottom: 0;
            color: #737b8c;
        }

        @@media (max-width: 767px) {
            .rentaly-testimonials

        {
            padding: 55px 0;
        }

        .testimonial-card {
            padding: 23px;
        }

        .testimonial-comment {
            min-height: auto;
        }

        }

        /* MÜŞTERİ YORUMLARI */
        .rentaly-testimonials {
            padding: 75px 0;
            background: #f6f7f9;
        }

        .testimonial-eyebrow,
        .faq-eyebrow {
            display: inline-block;
            margin-bottom: 12px;
            color: #e99a16;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .testimonial-heading,
        .faq-heading {
            color: #172033;
            font-size: clamp(27px, 3vw, 38px);
            font-weight: 750;
            margin-bottom: 14px;
        }

        .testimonial-subtitle,
        .faq-subtitle {
            max-width: 650px;
            margin: 0 auto;
            color: #737b8c;
            font-size: 15px;
            line-height: 1.8;
        }

        .testimonial-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 275px;
            padding: 25px;
            background: #fff;
            border: 1px solid #e9edf2;
            border-radius: 16px;
            box-shadow: 0 7px 24px rgba(20,35,60,.045);
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .testimonial-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 14px 32px rgba(20,35,60,.09);
            }

        .testimonial-stars {
            margin-bottom: 12px;
            font-size: 17px;
            letter-spacing: 2px;
        }

        .star-filled {
            color: #f5a623;
        }

        .star-empty {
            color: #dce1e8;
        }

        .testimonial-quote-mark {
            height: 27px;
            color: #f5a623;
            font-family: Georgia, serif;
            font-size: 43px;
            line-height: 1;
        }

        .testimonial-comment {
            flex: 1;
            margin: 12px 0 20px;
            color: #50596a;
            font-size: 14px;
            line-height: 1.8;
            overflow-wrap: anywhere;
        }

        .testimonial-divider {
            height: 1px;
            margin-bottom: 17px;
            background: #edf0f4;
        }

        .testimonial-customer {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .testimonial-avatar {
            display: flex;
            flex: 0 0 42px;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #fff2d9;
            color: #a96700;
            font-size: 17px;
            font-weight: 800;
        }

        .testimonial-name {
            margin: 0 0 4px;
            color: #172033;
            font-size: 14px;
            font-weight: 700;
        }

        .testimonial-job {
            color: #8790a0;
            font-size: 12px;
        }

        .testimonial-empty {
            max-width: 560px;
            margin: auto;
            padding: 35px 24px;
            text-align: center;
            background: #fff;
            border: 1px solid #e9edf2;
            border-radius: 16px;
        }

        .testimonial-empty-icon {
            margin-bottom: 10px;
            color: #f5a623;
            font-size: 38px;
        }

        .testimonial-empty h4 {
            color: #172033;
            font-weight: 700;
        }

        .testimonial-empty p {
            margin-bottom: 0;
            color: #737b8c;
        }

        /* SIK SORULAN SORULAR */
        .rentaly-faq {
            padding: 80px 0;
            background: #fff;
        }

            .rentaly-faq .container {
                max-width: 1000px;
            }

        .faq-heading-area {
            margin-bottom: 38px;
        }

        .rentaly-faq .accordion,
        .rentaly-faq .accordion-section {
            width: 100%;
        }

        .rentaly-faq .accordion-section {
            margin-bottom: 13px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e8ebf0;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(20,35,60,.035);
        }

        .rentaly-faq .accordion-section-title {
            padding: 20px 22px;
            color: #172033;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.6;
            cursor: pointer;
        }

            .rentaly-faq .accordion-section-title:hover {
                color: #c9820b;
                background: #fffaf1;
            }

        .rentaly-faq .accordion-section-content {
            padding: 0 22px 20px;
            color: #687183;
            font-size: 14px;
            line-height: 1.9;
        }

            .rentaly-faq .accordion-section-content p {
                margin-bottom: 0;
            }

        @@media (max-width: 767px) {
            .rentaly-testimonials,
            .rentaly-faq {
                padding: 50px 0;
            }

            .testimonial-card {
                min-height: 0;
                padding: 22px;
            }

            .testimonial-heading,
            .faq-heading {
                font-size: 27px;
            }

            .rentaly-faq .accordion-section-title {
                padding: 16px;
                font-size: 14px;
            }

            .rentaly-faq .accordion-section-content {
                padding: 0 16px 17px;
            }
        }
        /* SIZE SUNDUĞUMUZ AVANTAJLAR */
        .rentaly-advantages {
            padding: 80px 0;
            background: #fff;
            overflow: hidden;
        }

            .rentaly-advantages .advantages-heading {
                text-align: center;
                margin-bottom: 50px;
            }

                .rentaly-advantages .advantages-heading span {
                    display: inline-block;
                    color: #f5a623;
                    font-size: 12px;
                    font-weight: 800;
                    letter-spacing: 2px;
                    margin-bottom: 10px;
                }

                .rentaly-advantages .advantages-heading h2 {
                    color: #172033;
                    font-size: clamp(28px, 3vw, 38px);
                    font-weight: 750;
                    margin-bottom: 12px;
                }

                .rentaly-advantages .advantages-heading p {
                    color: #737b8c;
                    font-size: 15px;
                    line-height: 1.8;
                }

        .advantages-layout {
            display: grid;
            grid-template-columns: 1fr 1.35fr 1fr;
            align-items: center;
            gap: 28px;
        }

        .advantages-column {
            display: flex;
            flex-direction: column;
            gap: 38px;
        }

        .advantage-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

            .advantage-item.right {
                flex-direction: row-reverse;
                text-align: right;
            }

        .advantage-icon {
            flex: 0 0 48px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: #fff3dc;
            color: #d98b08;
            font-size: 23px;
        }

        .advantage-item h4 {
            color: #172033;
            font-size: 16px;
            font-weight: 750;
            margin: 2px 0 8px;
        }

        .advantage-item p {
            color: #737b8c;
            font-size: 13px;
            line-height: 1.8;
            margin: 0;
        }

        .advantages-car {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
        }

            .advantages-car img {
                display: block;
                width: 100%;
                max-width: 440px;
                height: auto;
                object-fit: contain;
                margin: 0 auto;
            }

        @@media (max-width: 991px) {
            .advantages-layout

        {
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }

        .advantages-car {
            grid-column: 1 / -1;
            grid-row: 1;
        }

            .advantages-car img {
                max-width: 400px;
            }

        .advantages-column {
            gap: 25px;
        }

        .advantage-item.right {
            flex-direction: row;
            text-align: left;
        }

        }

        @@media (max-width: 575px) {
            .rentaly-advantages

        {
            padding: 50px 0;
        }

        .advantages-layout {
            grid-template-columns: 1fr;
            gap: 25px;
        }

        .advantages-car {
            grid-column: auto;
            grid-row: auto;
        }

            .advantages-car img {
                max-width: 320px;
            }

        .advantages-column {
            gap: 24px;
        }

        }</style>

</head>

<body>

    <div id="wrapper">

        <!-- =========================================================
             PRELOADER
             ========================================================= -->

        <div id="de-preloader"></div>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <header class="transparent scroll-light has-topbar">

            <!-- TOPBAR -->

            <div id="topbar"
                 class="topbar-dark text-light">

                <div class="container">

                    <div class="topbar-left xs-hide">

                        <div class="topbar-widget">

                            <div class="topbar-widget">

                                <a href="#">
                                    <i class="fa fa-phone"></i>
                                    +90 555 555 55 55
                                </a>

                            </div>

                            <div class="topbar-widget">

                                <a href="mailto:contact@rentaly.com">

                                    <i class="fa fa-envelope"></i>

                                    contact@rentaly.com

                                </a>

                            </div>

                            <div class="topbar-widget">

                                <a href="#">

                                    <i class="fa fa-clock-o"></i>

                                    Pazartesi - Cuma 08:00 - 18:00

                                </a>

                            </div>

                        </div>

                    </div>


                    <div class="topbar-right">

                        <div class="social-icons">

                            <a href="#">
                                <i class="fa fa-facebook fa-lg"></i>
                            </a>

                            <a href="#">
                                <i class="fa fa-twitter fa-lg"></i>
                            </a>

                            <a href="#">
                                <i class="fa fa-youtube fa-lg"></i>
                            </a>

                            <a href="#">
                                <i class="fa fa-instagram fa-lg"></i>
                            </a>

                        </div>

                    </div>


