@model List<Rentaly.EntityLayer.Entities.About>

@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Hakkımızda</h3>
            <p class="text-muted mb-0">Ana sayfada gösterilecek hakkımızda bilgilerini yönetin.</p>
        </div>

        <a href="/Admin/About/CreateAbout" class="btn btn-primary">
            <i class="fa fa-plus"></i> Yeni Hakkımızda
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Mutlu Müşteri</th>
                            <th>Araç</th>
                            <th>Şube</th>
                            <th>Deneyim</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.AboutId</td>

                                <td>
                                    <strong>@item.Title</strong>
                                </td>

                                <td>
                                    @item.HappyCustomerCount
                                </td>

                                <td>
                                    @item.CarCount
                                </td>

                                <td>
                                    @item.BranchCount
                                </td>

                                <td>
                                    @item.ExperienceYear yıl
                                </td>

                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>

                                <td>

                                    <a href="/Admin/About/UpdateAbout/@item.AboutId"
                                       class="btn btn-sm btn-warning">
                                        Güncelle
                                    </a>

                                    <a href="/Admin/About/DeleteAbout/@item.AboutId"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                        Sil
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>