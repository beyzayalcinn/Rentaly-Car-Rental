
@model Rentaly.EntityLayer.Entities.Faq

@{
    ViewData["Title"] = "SSS Güncelle";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="mb-1">
                SSS Güncelle
            </h3>

            <p class="text-muted mb-0">
                Mevcut sıkça sorulan soru ve cevabını düzenleyin.
            </p>

        </div>


        <a href="/Admin/Faq/FaqList"
           class="btn btn-secondary">

            <i class="fa fa-arrow-left"></i>
            Listeye Dön

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form method="post"
                  action="/Admin/Faq/UpdateFaq">

                <input type="hidden"
                       asp-for="FaqId" />


                <div class="row">


                    <div class="col-md-12 mb-4">

                        <label asp-for="Question"
                               class="form-label">

                            Soru

                        </label>

                        <input asp-for="Question"
                               class="form-control"
                               placeholder="Soru" />

                    </div>


                    <div class="col-md-12 mb-4">

                        <label asp-for="Answer"
                               class="form-label">

                            Cevap

                        </label>

                        <textarea asp-for="Answer"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Cevap"></textarea>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Order"
                               class="form-label">

                            Sıra

                        </label>

                        <input asp-for="Order"
                               type="number"
                               class="form-control"
                               min="1" />

                    </div>


                    <div class="col-md-6 mb-3 d-flex align-items-end">

                        <div class="form-check mb-2">

                            <input asp-for="Status"
                                   class="form-check-input" />

                            <label asp-for="Status"
                                   class="form-check-label">

                                Aktif olarak göster

                            </label>

                        </div>

                    </div>

                </div>


                <div class="d-flex justify-content-end gap-2">

                    <a href="/Admin/Faq/FaqList"
                       class="btn btn-light">

                        İptal

                    </a>


                    <button type="submit"
                            class="btn btn-warning">

                        <i class="fa fa-edit"></i>
                        Güncelle

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
